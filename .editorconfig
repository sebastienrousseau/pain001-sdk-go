# SPDX-License-Identifier: Apache-2.0 OR MIT
# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.go]
indent_style = tab

[{Makefile,*.mk}]
indent_style = tab

[*.md]
# Two trailing spaces are a Markdown line break; the docs do not use
# them, but trimming must not change meaning if one ever does.
trim_trailing_whitespace = false

[{conformance/**,testdata/**,LICENSES/**,DCO.txt,LICENSE*}]
# Vendored, recorded or legal text: kept byte for byte.
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset

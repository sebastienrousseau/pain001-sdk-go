# codespell, run by the docs-lint workflow and pre-commit. Skipped: the
# vendored kit (linted in core), licence texts, binary and recorded data,
# lockfiles, and build output.
[codespell]
skip = ./.git,./conformance,./LICENSES,./testdata,./bin,./dist,./site,*.gif,./ci/*.txt,./KEYS.asc
check-hidden = true
